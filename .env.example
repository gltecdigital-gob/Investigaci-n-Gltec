# Copia este archivo como .env.local y rellena los valores. .env.local no se sube a GitHub.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secreta: solo para los scripts de ingesta. Nunca en el navegador ni en el repositorio.
SUPABASE_SECRET_KEY=sb_secret_...

# Google Cloud Console → APIs y servicios → Credenciales (YouTube Data API v3 habilitada)
YOUTUBE_API_KEY=
